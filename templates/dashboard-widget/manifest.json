{
  "manifest_version": 2.0,
  "id": "template_widget_id",
  "name": "Template Widget Name",
  "version": "1.0.0",
  "namespace": "TemplateNamespace",
  "author": "Leandro Monasterio",
  "description": "Template Widget Description",
  "url": "https://github.com/leandromonasterio/zabbix-modules",
  "type": "widget",
  "widget": {
    "name": "Template Widget Name",
    "size": {
      "width": 12,
      "height": 6
    },
    "form_class": "WidgetForm",
    "js_class": "WidgetTemplate",
    "use_time_selector": false,
    "refresh_rate": 60
  },
  "actions": {
    "widget.template_widget_id.view": {
      "class": "WidgetView"
    }
  },
  "assets": {
    "css": ["widget.css"],
    "js": ["class.widget.js"]
  }
}
