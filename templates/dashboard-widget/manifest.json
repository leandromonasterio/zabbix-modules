{
  "manifest_version": 2.0,
  "id": "{{MODULE_ID}}",
  "name": "{{MODULE_NAME}}",
  "version": "1.0.0",
  "namespace": "{{MODULE_NAMESPACE}}",
  "author": "{{MODULE_AUTHOR}}",
  "description": "{{MODULE_DESCRIPTION}}",
  "url": "https://github.com/leandromonasterio/zabbix-modules",
  "type": "widget",
  "widget": {
    "name": "{{MODULE_NAME}}",
    "size": {
      "width": 12,
      "height": 6
    },
    "form_class": "WidgetForm",
    "js_class": "{{JS_CLASS}}",
    "use_time_selector": false,
    "refresh_rate": 60
  },
  "actions": {
    "widget.{{MODULE_ID}}.view": {
      "class": "WidgetView"
    }
  },
  "assets": {
    "css": ["widget.css"],
    "js": ["class.widget.js"]
  }
}
